{
  "//": "体量预算：唯一真相。scripts/budget.py 读它；fileLines 是可接受上限，tiers 按上限的百分比分警告 / 阻断。",
  "tiers": {
    "warnPercent": 85,
    "blockPercent": 120
  },
  "defaults": {
    "fileLines": 1000
  },
  "suffixes": {
    ".md": { "fileLines": 500 },
    ".ts": { "fileLines": 1000 },
    ".tsx": { "fileLines": 1000 }
  },
  "names": {
    "test_*.py": { "fileLines": 1200 },
    "*.test.ts": { "fileLines": 1200 },
    "*.test.tsx": { "fileLines": 1200 }
  },
  "paths": {
    "README.md": { "fileLines": 300 },
    "AGENTS.md": { "fileLines": 300 },
    "docs": { "fileLines": 500 }
  }
}
