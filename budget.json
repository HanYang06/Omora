{
  "//": "体量预算：唯一真相。scripts/check.py 与 web/eslint.config.js 都读取本文件。",
  "defaults": {
    "fileLines": 300,
    "functionLines": 60,
    "classMethods": 15,
    "params": 5,
    "complexity": 12,
    "imports": 20
  },
  "suffixes": {
    ".md": { "fileLines": 400 },
    ".json": { "fileLines": 400 },
    ".yml": { "fileLines": 300 },
    ".yaml": { "fileLines": 300 },
    ".ts": { "fileLines": 300 },
    ".tsx": { "fileLines": 220, "functionLines": 80 }
  },
  "paths": {
    "scripts": { "fileLines": 400, "functionLines": 80, "complexity": 15, "imports": 25 },
    "docs": { "fileLines": 400 },
    ".agents/skills/omora-project": { "fileLines": 500 }
  }
}
