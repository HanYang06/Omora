{
  "id": "omora.requirements",
  "name": "Requirements",
  "version": "0.1.0",
  "engines": {
    "omora": "^0.1.0"
  },
  "runtime": "python",
  "entry": "omora_plugins_requirements:plugin",
  "activation": [
    "onStartup"
  ],
  "capabilities": [
    "commands",
    "events",
    "queries",
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "id": "requirements.create",
        "title": "新建需求"
      },
      {
        "id": "requirements.setStatus",
        "title": "推进需求状态"
      }
    ],
    "slots": [
      {
        "id": "requirements.main",
        "slot": "main",
        "order": 20
      }
    ]
  }
}
