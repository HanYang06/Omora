{
  "id": "omora.projects",
  "name": "Projects",
  "version": "0.1.0",
  "engines": {
    "omora": "^0.1.0"
  },
  "runtime": "python",
  "entry": "omora_plugins_projects:plugin",
  "activation": [
    "onStartup"
  ],
  "capabilities": [
    "commands",
    "events",
    "queries",
    "services",
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "id": "projects.create",
        "title": "新建项目"
      },
      {
        "id": "projects.archive",
        "title": "归档项目"
      },
      {
        "id": "projects.focus",
        "title": "查看项目"
      }
    ],
    "slots": [
      {
        "id": "projects.sidebar",
        "slot": "sidebar",
        "order": 20
      }
    ]
  }
}
