{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omora.dev/schema/dendro.tree/1",
  "title": "Dendrolink Tree V1",
  "description": "Dendrolink tree format V1. One Node primitive; only layout nests nodes. Partials mount by stable node id; documents add pages/active/data/ledger. This file is the single source for fields, types and structural roles.",
  "oneOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "$ref": "#/$defs/partial"
    },
    {
      "$ref": "#/$defs/node"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "稳定身份：16 位小写十六进制；出生后不变。"
    },
    "chain": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(\\.[0-9a-f]{16})*$",
      "description": "结构地址：父 chain + '.' + id；根 chain 等于 id。"
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": ["string", "number"]
            },
            "height": {
              "type": ["string", "number"]
            }
          }
        },
        "align": {
          "enum": ["start", "center", "stretch"]
        },
        "span": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "mode"],
      "properties": {
        "parent": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": ["new", "overlay"]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chain", "kind", "order", "layout", "settings", "bind", "on", "emit"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "chain": {
          "$ref": "#/$defs/chain"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "slot": {
          "$ref": "#/$defs/placement"
        },
        "settings": {
          "type": "object"
        },
        "bind": {
          "type": "object"
        },
        "on": {
          "type": "object"
        },
        "emit": {
          "type": "object"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "route"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "root", "pages", "active", "data"],
      "properties": {
        "schema": {
          "const": "dendro.tree/1"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "root": {
          "allOf": [
            {
              "$ref": "#/$defs/node"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "app"
                }
              }
            }
          ]
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        "active": {
          "type": "string"
        },
        "data": {
          "type": "object"
        },
        "ledger": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ledgerEntry"
          }
        }
      }
    },
    "partial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source", "mount", "root"],
      "properties": {
        "schema": {
          "const": "dendro.tree/1"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "mount": {
          "$ref": "#/$defs/mount"
        },
        "root": {
          "$ref": "#/$defs/node"
        }
      }
    }
  },
  "x-omora": {
    "idField": "id",
    "chainField": "chain",
    "orderField": "order",
    "layoutField": "layout",
    "nonNestingFields": ["settings", "bind", "on", "emit"],
    "rootKind": "app",
    "mountModes": ["new", "overlay"]
  }
}
