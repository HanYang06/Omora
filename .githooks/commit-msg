#!/bin/sh
root="$(git rev-parse --show-toplevel)"
if [ -x "$root/.venv/Scripts/python.exe" ]; then
    exec "$root/.venv/Scripts/python.exe" "$root/scripts/commit_msg.py" "$1"
fi
if [ -x "$root/.venv/bin/python" ]; then
    exec "$root/.venv/bin/python" "$root/scripts/commit_msg.py" "$1"
fi
exec uv run --project "$root" python "$root/scripts/commit_msg.py" "$1"
