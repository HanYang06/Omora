{
  "id": "omora.ideas",
  "name": "Ideas",
  "version": "0.1.0",
  "engines": {
    "omora": "^0.1.0"
  },
  "runtime": "python",
  "entry": "omora_plugins_ideas:plugin",
  "activation": [
    "onStartup",
    "onCommand:ideas.create"
  ],
  "capabilities": [
    "storage",
    "events",
    "ui",
    "commands"
  ],
  "contributes": {
    "commands": [
      {
        "id": "ideas.create",
        "title": "新建灵感"
      },
      {
        "id": "ideas.flush",
        "title": "立即保存"
      }
    ],
    "slots": [
      {
        "id": "ideas.panel",
        "slot": "sidebar",
        "order": 10
      }
    ]
  }
}
