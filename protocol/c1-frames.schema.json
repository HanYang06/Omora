{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omora.dev/protocol/c1-frames.schema.json",
  "title": "C1Frame",
  "description": "C1 帧:JSON-RPC 2.0。命令上行、事件下行、快照兜底。revision 单调递增,前端据此去重与断线追赶。",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Notification"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "RequestId": {
      "type": [
        "string",
        "integer"
      ]
    },
    "StateSnapshotParams": {
      "type": "object",
      "additionalProperties": false
    },
    "CmdInvokeParams": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "QueryInvokeParams": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        },
        "cursor": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "EventSubscribeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "since": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PingParams": {
      "type": "object",
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "method": {
              "const": "state.snapshot"
            },
            "params": {
              "$ref": "#/$defs/StateSnapshotParams"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "method": {
              "const": "cmd.invoke"
            },
            "params": {
              "$ref": "#/$defs/CmdInvokeParams"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "method": {
              "const": "query.invoke"
            },
            "params": {
              "$ref": "#/$defs/QueryInvokeParams"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "method": {
              "const": "event.subscribe"
            },
            "params": {
              "$ref": "#/$defs/EventSubscribeParams"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "method": {
              "const": "ping"
            },
            "params": {
              "$ref": "#/$defs/PingParams"
            }
          }
        }
      ]
    },
    "Notification": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "const": "event"
        },
        "params": {
          "type": "object",
          "required": [
            "type",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    },
    "ErrorCode": {
      "enum": [
        "E_INVALID",
        "E_DENIED",
        "E_UNAVAILABLE",
        "E_INTERNAL"
      ]
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "result"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "result": {
              "type": [
                "object",
                "array",
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "jsonrpc",
            "id",
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/RequestId"
            },
            "error": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "$ref": "#/$defs/ErrorCode"
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "data": {
                  "type": "object"
                }
              }
            }
          }
        }
      ]
    }
  }
}
