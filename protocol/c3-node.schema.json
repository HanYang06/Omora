{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omora.dev/protocol/c3-node.schema.json",
  "title": "C3Node",
  "description": "插件产出的声明式 UI 节点。渲染器只认这里声明的 type 与 props;未知 type 必须降级为占位符,不得崩溃。以 $ 开头的字符串是数据绑定,其余按字面量处理。",
  "oneOf": [
    {
      "$ref": "#/$defs/Stack"
    },
    {
      "$ref": "#/$defs/Text"
    },
    {
      "$ref": "#/$defs/Button"
    },
    {
      "$ref": "#/$defs/Input"
    },
    {
      "$ref": "#/$defs/List"
    },
    {
      "$ref": "#/$defs/Card"
    }
  ],
  "$defs": {
    "Scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "CommandRef": {
      "type": "object",
      "required": [
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Scalar"
          }
        }
      }
    },
    "Stack": {
      "type": "object",
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Stack"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": [
                "vertical",
                "horizontal"
              ]
            },
            "gap": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    "Text": {
      "type": "object",
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Text"
        },
        "props": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "variant": {
              "enum": [
                "title",
                "subtitle",
                "body",
                "caption",
                "mono"
              ]
            }
          }
        }
      }
    },
    "Button": {
      "type": "object",
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Button"
        },
        "props": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "disabled": {
              "type": "boolean"
            },
            "variant": {
              "enum": [
                "primary",
                "ghost",
                "danger"
              ]
            }
          }
        },
        "on": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "click": {
              "$ref": "#/$defs/CommandRef"
            }
          }
        }
      }
    },
    "Input": {
      "type": "object",
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Input"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "placeholder": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "disabled": {
              "type": "boolean"
            }
          }
        },
        "on": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "submit": {
              "$ref": "#/$defs/CommandRef"
            },
            "change": {
              "$ref": "#/$defs/CommandRef"
            }
          }
        }
      }
    },
    "List": {
      "type": "object",
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "List"
        },
        "props": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "string",
              "description": "绑定到数组的表达式,如 $ideas"
            },
            "emptyText": {
              "type": "string"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#"
          },
          "description": "每项的模板,作用域内可用 $item"
        }
      }
    },
    "Card": {
      "type": "object",
      "required": [
        "type",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Card"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      }
    }
  }
}
